# ---- NEXORA authentication settings (copy this file to `.env`) ----

# Port the website runs on
PORT=3000

# REQUIRED in production: a long random string used to sign login sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# The administrator account, created automatically the first time the server starts.
# If ADMIN_PASSWORD is empty, a random one is generated and printed in the console once.
ADMIN_EMAIL="admin@yourstore.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Store Administrator"

# Optional: where user accounts are stored (default: ./data)
# DATA_DIR="./data"
